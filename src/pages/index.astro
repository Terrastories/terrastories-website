---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Seo from '../components/Seo.astro';
import PostCard from '../components/PostCard.astro';
import PartnerLogo from '../components/PartnerLogo.astro';

const pages = await getCollection('pages');
const home = pages.find((page) => page.data.slug === 'home');

if (!home) {
  throw new Error('Missing home page content.');
}

const { Content } = await render(home);

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const sponsors = [
  { name: 'Awana Digital', href: 'https://awana.digital', src: '/media/images/748_AwanaDigital-Logomark-HiRes.png' },
];

const partners = [
  { name: 'Earth Defenders Toolkit', href: 'https://earthdefenderstoolkit.com', src: '/media/images/432_EDT-asset-dark-logo.png' },
  { name: 'Amazon Conservation Team', href: 'https://amazonteam.org', src: '/media/images/81_ACT-HQ_SQ_ENG_ASH.png' },
  { name: 'Ruby for Good', href: 'https://rubyforgood.org', src: '/media/images/83_rubyforgood.png' },
  { name: 'Mapbox', href: 'https://mapbox.com', src: '/media/images/82_mapbox-logo-blue-square.png' },
  { name: 'ATALM', href: 'https://atalm.org/', src: '/media/images/565_ATALM-logo_og.png' },
  { name: 'Tech Matters', href: 'https://techmatters.org', src: '/media/images/409_tech_matters_JPG_viewimage.jpg' },
  { name: 'Ohneganos', href: 'https://www.ohneganos.com/', src: '/media/images/433_ohneganos.png' },
  { name: 'Indigenous Mapping Workshop', href: 'https://indigenousmaps.com', src: '/media/images/435_IndigenousMaps.jpg' },
];
---

<BaseLayout>
  <Seo slot="seo" frontmatter={home.data} pathname="/" />

  <!-- Hero Section -->
  <section class="bg-paper px-6 py-14">
    <div class="mx-auto max-w-5xl">
      <div class="prose prose-stone max-w-none prose-a:text-river prose-img:rounded">
        <Content />
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-6">
        <img src="/media/images/78_E-WEB-Goal-04-350x350-1.png" alt="UN Sustainable Development Goal 4: Quality Education" class="h-28 w-28 sm:h-32 sm:w-32" loading="lazy" />
        <img src="/media/images/79_E-WEB-Goal-11-350x350-1.png" alt="UN Sustainable Development Goal 11: Sustainable Cities and Communities" class="h-28 w-28 sm:h-32 sm:w-32" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Latest Stories -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="mb-8 flex items-end justify-between gap-4">
      <h2 class="text-3xl font-bold text-ink">Latest Stories</h2>
      <a class="text-sm font-semibold text-river hover:text-forest" href="/blog">View all</a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- Help Us Grow CTA -->
  <section class="bg-forest px-6 py-16 text-center text-white">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold">Help Us Grow</h2>
      <p class="mt-4 text-lg text-white/80">
        We are an entirely open-source project that depends on donations and volunteer software development.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/sponsor-us"
          class="rounded-lg bg-clay px-6 py-3 font-semibold text-white transition-colors hover:bg-clay/90"
        >
          Sponsor Us
        </a>
        <a
          href="/contribute"
          class="rounded-lg border-2 border-white/30 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/10"
        >
          Be a Developer
        </a>
      </div>
    </div>
  </section>

  <!-- Sponsors & Partners -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-12 text-center text-3xl font-bold text-ink">Sponsors & Partners</h2>

      <h3 class="mb-8 text-center text-xl font-semibold text-ink">Sponsored By</h3>
      <div class="mb-16 flex flex-wrap items-center justify-center gap-6">
        {sponsors.map((s) => <PartnerLogo name={s.name} href={s.href} src={s.src} />)}
      </div>

      <h3 class="mb-8 text-center text-xl font-semibold text-ink">Special Thanks to Our Partners</h3>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
        {partners.map((p) => <PartnerLogo name={p.name} href={p.href} src={p.src} />)}
      </div>

      <div class="mt-10 text-center">
        <a
          href="mailto:terrastoriesorg@gmail.com"
          class="text-sm font-semibold text-river hover:text-forest"
        >
          Become a partner
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
