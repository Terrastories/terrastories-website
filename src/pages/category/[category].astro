---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Seo from '../../components/Seo.astro';
import PostCard from '../../components/PostCard.astro';
import { categorySlug } from '../../utils/category';

const titleFromSlug = (slug: string) => slug.split('-').map((word) => word[0].toUpperCase() + word.slice(1)).join(' ');

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const categories = new Set(allPosts.flatMap((post) => post.data.categories.map(categorySlug)));

  return [...categories].map((category) => {
    const posts = allPosts
      .filter((post) => post.data.categories.some((item) => categorySlug(item) === category))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { category },
      props: { posts },
    };
  });
}

const { category } = Astro.params;
const { posts } = Astro.props;

const title = titleFromSlug(category ?? '');
const descriptions: Record<string, string> = {
  'User Stories': 'Real-world accounts from Indigenous and local communities using Terrastories to map, protect, and share their place-based stories and cultural heritage.',
  'Dev Stories': 'Updates, contributions, and technical stories from the open-source community building Terrastories.',
  'Developer Community': 'Updates, contributions, and technical stories from the open-source community building Terrastories.',
  'Field Notes': 'Notes and reflections from the field as communities document their oral histories and territories.',
  'Uncategorized': 'Terrastories posts.',
};
const description = descriptions[title] || `Terrastories posts in the ${title} category.`;
const frontmatter = {
  title,
  seo_title: `${title} - Terrastories`,
  seo_description: description,
};
---

<BaseLayout>
  <Seo slot="seo" frontmatter={frontmatter} pathname={`/category/${category}`} />

  <section class="mx-auto max-w-7xl px-6 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-heading md:text-5xl uppercase">{title}</h1>
      <p class="mt-4 max-w-3xl text-lg text-stone-700">{description}</p>
      <p class="mt-2 text-sm text-stone-500">{posts.length} posts</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
