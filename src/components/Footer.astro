---
import { navItems, socialLinks, isExternal } from '../data/nav';

const footerNavLeft = navItems.slice(0, 4);
const footerNavRight = navItems.slice(4);
---

<footer class="bg-teal text-white">
  <div class="mx-auto max-w-7xl px-6 py-10">
    <!-- FOLLOW US social section -->
    <div class="mb-8 text-center">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white/90 mb-3">Follow Us</h2>
      <div class="flex items-center justify-center gap-4">
        {socialLinks.map((s) => (
          <a
            href={s.href}
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white/80 transition-all hover:bg-white/20 hover:text-white hover:shadow-[0_0_0.75rem_rgba(255,255,255,0.45)]"
            aria-label={s.label}
            {...(isExternal(s.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {s.icon === 'twitter' && (
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            )}
            {s.icon === 'github' && (
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            )}
            {s.icon === 'mail' && (
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Icon -->
    <div class="text-center">
      <img src="/media/images/40_Terrastories-icon-sq.png" alt="Terrastories" class="mx-auto h-20 w-20" loading="lazy" />
    </div>

    <!-- Description -->
    <div class="mt-6 text-center">
      <p class="text-sm text-white/80">
        A free and open-source application for communities to map, protect, and share place-based stories.
      </p>
    </div>

    <!-- Footer nav — two columns -->
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-8 text-sm">
      <nav aria-label="Resources">
        <ul class="flex flex-col items-center gap-2 sm:items-end">
        {footerNavLeft.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-white hover:text-gold transition-colors"
              {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
            {item.children && (
              <ul class="mt-1 flex flex-col items-center gap-1 text-xs text-white/75 sm:items-end">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="hover:text-gold transition-colors"
                      {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
        </ul>
      </nav>
      <nav aria-label="Community">
        <ul class="flex flex-col items-center gap-2 sm:items-start">
        {footerNavRight.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-white hover:text-gold transition-colors"
              {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
            {item.children && (
              <ul class="mt-1 flex flex-col items-center gap-1 text-xs text-white/75 sm:items-start">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="hover:text-gold transition-colors"
                      {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-white/20 pt-5 text-center text-xs text-white/60">
      &copy; {new Date().getFullYear()} Terrastories
    </div>
  </div>
</footer>
