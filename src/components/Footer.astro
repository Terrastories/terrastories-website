---
import { navItems, isExternal } from '../data/nav';
import { basePathOf } from '../utils/basePath';

const footerNavLeft = navItems.slice(0, 4);
const footerNavRight = navItems.slice(4);
---

<footer class="bg-teal text-white">
  <div class="mx-auto max-w-7xl px-6 py-10">
    <!-- Icon -->
    <div class="text-center">
      <img src={basePathOf('/media/images/40_Terrastories-icon-sq.png')} alt="Terrastories" class="mx-auto h-20 w-20" loading="lazy" />
    </div>

    <!-- Description -->
    <div class="mt-6 text-center">
      <p class="text-sm text-white/80">
        A free and open-source application for communities to map, protect, and share place-based stories.
      </p>
    </div>

    <!-- Footer nav — two columns -->
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-8 text-sm">
      <nav aria-label="Resources">
        <ul class="flex flex-col items-center gap-2 text-center sm:items-end sm:text-right">
        {footerNavLeft.map((item) => (
          <li>
            <a
              href={isExternal(item.href) ? item.href : basePathOf(item.href)}
              class="text-white hover:text-gold transition-colors"
              {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
            {item.children && (
              <ul class="mt-1 flex flex-col items-center gap-1 text-xs text-white/75 sm:items-end">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={isExternal(child.href) ? child.href : basePathOf(child.href)}
                      class="hover:text-gold transition-colors"
                      {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
        </ul>
      </nav>
      <nav aria-label="Community">
        <ul class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
        {footerNavRight.map((item) => (
          <li>
            <a
              href={isExternal(item.href) ? item.href : basePathOf(item.href)}
              class="text-white hover:text-gold transition-colors"
              {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
            {item.children && (
              <ul class="mt-1 flex flex-col items-center gap-1 text-xs text-white/75 sm:items-start">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={isExternal(child.href) ? child.href : basePathOf(child.href)}
                      class="hover:text-gold transition-colors"
                      {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-white/20 pt-5 text-center text-xs text-white/60">
      &copy; {new Date().getFullYear()} Terrastories
    </div>
  </div>
</footer>
