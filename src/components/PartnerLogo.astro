---
interface Props {
  name: string;
  href: string;
  src: string;
}

import { basePathOf } from '../utils/basePath';

const { name, href, src } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={name}
  class="flex items-center justify-center bg-white p-2"
>
  <img
    src={basePathOf(src)}
    alt={`${name} logo`}
    loading="lazy"
    class="max-h-20 w-auto object-contain"
  />
</a>
