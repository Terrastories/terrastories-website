---
import { navItems, exploreHref, isExternal } from '../data/nav';
import { basePathOf } from '../utils/basePath';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="border-b-[5px] border-orange bg-white">
  <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:bg-white focus:p-3" href="#main-content">
    Skip to content
  </a>

  <nav class="flex w-full items-stretch justify-between h-[74px]" aria-label="Main navigation">
    <!-- Logo -->
    <a href={basePathOf('/')} aria-label="Terrastories home" class="flex items-center shrink-0 pl-6">
      <img src={basePathOf('/media/images/nav-logo.png')} alt="Terrastories" class="w-[200px] md:w-[300px] h-auto" />
    </a>

    <!-- Right group: desktop nav links + CTA, flush right -->
    <div class="hidden lg:flex items-stretch">
      <!-- Desktop nav links -->
      <div class="flex items-center gap-x-3 lg:gap-x-5 text-[13px] lg:text-sm font-medium text-black lg:flex-nowrap">
      {navItems.map((item) => (
        <div class="group relative shrink-0">
          <a
            class:list={[
              'text-black hover:text-orange transition-colors inline-flex items-center gap-0.5 whitespace-nowrap',
              currentPath === item.href ? 'text-orange' : '',
            ]}
            href={isExternal(item.href) ? item.href : basePathOf(item.href)}
            {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {item.label}
            {item.children && (
              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>

          {item.children && (
            <div class="invisible opacity-0 transition-all duration-200 absolute left-0 top-full pt-2 z-50 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <ul class="border-t-2 border-teal bg-white shadow-lg py-2 min-w-[200px]">
                {item.children.map((child) => (
                  <li>
                    <a
                      class="block px-5 py-2 text-sm text-body hover:text-orange hover:bg-stone-50 transition-colors whitespace-nowrap"
                      href={isExternal(child.href) ? child.href : basePathOf(child.href)}
                      {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}

      <!-- CTA: full-height orange block, flush right -->
      <a
        class="flex h-full items-center justify-center bg-orange text-white font-semibold text-sm px-6 lg:px-8 shrink-0 hover:bg-gold transition-colors"
        href={exploreHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore Terrastories
      </a>
    </div>

    <!-- Burger button (mobile) -->
    <button
      id="menu-toggle"
      class="menu-toggle relative z-50 flex h-10 w-10 items-center justify-center rounded-none bg-orange text-white lg:hidden shrink-0 self-center"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="burger-icon" aria-hidden="true">
        <span class="burger-line burger-line--top"></span>
        <span class="burger-line burger-line--middle"></span>
        <span class="burger-line burger-line--bottom"></span>
      </span>
    </button>
  </nav>

  <!-- Mobile overlay -->
  <div id="menu-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/0 backdrop-blur-none transition-all duration-500 ease-in-out lg:hidden"></div>

  <!-- Mobile slide-in panel -->
  <div id="menu-panel" class="fixed right-0 top-0 z-40 h-full w-72 translate-x-full transform bg-white shadow-2xl transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] lg:hidden" role="dialog" aria-label="Navigation menu">
    <div class="flex flex-col px-6 pt-20 pb-8 overflow-y-auto max-h-full">
      <div class="flex flex-col gap-1">
        {navItems.map((item) => (
          <div>
            <a
              class:list={[
                'block rounded-lg px-4 py-3 text-base font-medium text-body transition-colors hover:bg-stone-100 hover:text-orange',
                currentPath === item.href ? 'bg-stone-50 text-orange font-semibold' : '',
              ]}
              href={isExternal(item.href) ? item.href : basePathOf(item.href)}
              {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
            {item.children && (
              <div class="pl-6">
                {item.children.map((child) => (
                  <a
                    class="block px-4 py-2 text-sm text-stone-600 hover:text-orange hover:bg-stone-50 rounded-lg transition-colors"
                    href={isExternal(child.href) ? child.href : basePathOf(child.href)}
                    {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="mt-6 border-t border-stone-200 pt-6">
        <a class="btn block text-center" href={exploreHref} target="_blank" rel="noopener noreferrer">
          Explore Terrastories
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .burger-icon {
    position: absolute;
    inset: 0;
    display: block;
  }

  .burger-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 2.5px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 0.4s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.4s cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform, opacity;
    -webkit-transform-origin: center;
  }

  .burger-line--top {
    transform: translate(-50%, -50%) translateY(-6px);
  }

  .burger-line--middle {
    transform: translate(-50%, -50%) scaleX(1);
  }

  .burger-line--bottom {
    transform: translate(-50%, -50%) translateY(6px);
  }

  .menu-toggle.is-open .burger-line--top {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .menu-toggle.is-open .burger-line--middle {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0);
  }

  .menu-toggle.is-open .burger-line--bottom {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const overlay = document.getElementById('menu-overlay');
  const panel = document.getElementById('menu-panel');

  let open = false;

  // Focus trap helpers
  function getFocusableElements(container: HTMLElement): HTMLElement[] {
    return Array.from(
      container.querySelectorAll<HTMLElement>('a[href], button, input, textarea, select, details, [tabindex]:not([tabindex="-1"])')
    ).filter(el => !el.hasAttribute('disabled') && el.offsetParent !== null);
  }

  function trapFocus(e: KeyboardEvent) {
    if (!panel || e.key !== 'Tab') return;
    const focusable = getFocusableElements(panel);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  function closeMenu() {
    open = false;
    panel!.classList.add('translate-x-full');
    panel!.classList.remove('translate-x-0');
    overlay!.classList.remove('bg-black/40', 'backdrop-blur-sm', 'pointer-events-auto');
    overlay!.classList.add('bg-black/0', 'backdrop-blur-none', 'pointer-events-none');
    toggle!.setAttribute('aria-expanded', 'false');
    toggle!.setAttribute('aria-label', 'Open menu');
    toggle!.classList.remove('is-open');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', trapFocus);
    toggle!.focus();
  }

  function openMenu() {
    open = true;
    panel!.classList.remove('translate-x-full');
    panel!.classList.add('translate-x-0');
    overlay!.classList.add('bg-black/40', 'backdrop-blur-sm', 'pointer-events-auto');
    overlay!.classList.remove('bg-black/0', 'backdrop-blur-none', 'pointer-events-none');
    toggle!.setAttribute('aria-expanded', 'true');
    toggle!.setAttribute('aria-label', 'Close menu');
    toggle!.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', trapFocus);
    // Focus first focusable element in panel
    const focusable = getFocusableElements(panel!);
    if (focusable.length > 0) {
      setTimeout(() => focusable[0].focus(), 100);
    }
  }

  toggle!.addEventListener('click', () => {
    if (open) closeMenu();
    else openMenu();
  });

  overlay!.addEventListener('click', closeMenu);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) closeMenu();
  });
</script>
