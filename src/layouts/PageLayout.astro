---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Seo from '../components/Seo.astro';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout>
  <Seo slot="seo" frontmatter={page.data} pathname={page.data.canonical ?? `/${page.data.slug}`} />

  <article class="mx-auto max-w-4xl px-6 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-heading uppercase tracking-wide text-teal md:text-5xl">{page.data.title}</h1>
    </header>

    <div class="prose prose-stone max-w-none prose-a:text-orange">
      <Content />
    </div>
  </article>
</BaseLayout>
