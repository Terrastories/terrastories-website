---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Seo from '../components/Seo.astro';
import { categorySlug } from '../utils/category';
import { basePathOf } from '../utils/basePath';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const image = post.data.featured_image ?? post.data.og_image;

const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

---

<BaseLayout>
  <Seo slot="seo" frontmatter={post.data} pathname={`/blog/${post.data.slug}`} type="article" />

  <article class="mx-auto max-w-3xl px-6 py-12">
    <header class="mb-10">
      <div class="mb-4 flex flex-wrap gap-2">
        {post.data.categories.map((category) => (
          <a class="rounded-none bg-orange px-3 py-1 text-sm font-medium text-white hover:bg-gold transition-colors" href={basePathOf(`/category/${categorySlug(category)}`)}>
            {category}
          </a>
        ))}
      </div>

      <h1 class="text-4xl font-heading uppercase tracking-wide text-teal md:text-5xl">{post.data.title}</h1>

      <p class="mt-4 text-sm text-stone-600">
        <time datetime={post.data.date.toISOString()}>{date}</time>
      </p>

      {post.data.excerpt && <p class="mt-6 text-lg text-stone-700">{post.data.excerpt}</p>}
    </header>

    {image && (
      <img class="mb-10 aspect-video w-full object-cover" src={basePathOf(image)} alt={post.data.title} loading="lazy" />
    )}

    <div class="prose prose-stone max-w-none prose-a:text-orange">
      <Content />
    </div>
  </article>
</BaseLayout>
