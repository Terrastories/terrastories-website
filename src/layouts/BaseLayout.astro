---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { basePathOf } from '../utils/basePath';

interface Props {
  bodyClass?: string;
}

const { bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Oswald:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href={basePathOf('/favicon.ico')} />
    <link rel="icon" type="image/png" sizes="32x32" href={basePathOf('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={basePathOf('/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={basePathOf('/apple-touch-icon.png')} />
    <link rel="icon" href={basePathOf('/favicon.svg')} />
    <slot name="seo" />
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
