---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  bodyClass?: string;
}

const { bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <slot name="seo" />
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
