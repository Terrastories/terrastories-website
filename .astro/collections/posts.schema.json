{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "excerpt": {
      "default": "",
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "featured_image": {
      "type": "string"
    },
    "featured_image_id": {
      "type": "number"
    },
    "og_image": {
      "type": "string"
    },
    "canonical": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "categories": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "date",
    "modified",
    "author"
  ]
}